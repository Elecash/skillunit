{
  "name": "skillunit",
  "version": "0.1.0",
  "description": "Keeps an agent skill in sync with the code it describes. Tests that the skill text settles the decisions it must, with closed questions to a decision model.",
  "license": "MIT",
  "homepage": "https://github.com/Elecash/skillunit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elecash/skillunit.git",
    "directory": "packages/skillunit"
  },
  "bugs": {
    "url": "https://github.com/Elecash/skillunit/issues"
  },
  "keywords": [
    "agent",
    "skills",
    "skill",
    "testing",
    "llm",
    "mcp",
    "typesafe",
    "ci"
  ],
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "bin": {
    "skillunit": "./bin/skillunit.js"
  },
  "files": [
    "bin",
    "dist",
    "skills/skillunit",
    "README.md",
    "LICENSE"
  ],
  "nx": {
    "name": "skillunit"
  },
  "scripts": {
    "build": "node ../../tools/tsc.mjs -p tsconfig.build.json",
    "typecheck": "node ../../tools/tsc.mjs --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepack": "node scripts/copy-shared-files.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "8.1.3",
    "@typesafe-ai/sdk": "^0.6.0",
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.1.1"
  }
}
