{
  "name": "skillunit",
  "version": "0.0.0",
  "description": "Checks that an agent skill still says what the code it describes does: lint for its examples and format, proof from the project's own tests, and closed-question tests with a decision model.",
  "license": "MIT",
  "author": "Raúl Jiménez",
  "homepage": "https://github.com/Elecash/skillunit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elecash/skillunit.git",
    "directory": "packages/skillunit"
  },
  "bugs": {
    "url": "https://github.com/Elecash/skillunit/issues"
  },
  "keywords": [
    "agent",
    "agent-skills",
    "skills",
    "skill",
    "testing",
    "lint",
    "llm",
    "typesafe",
    "ci"
  ],
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "bin": {
    "skillunit": "bin/skillunit.js"
  },
  "exports": {
    "./proof": {
      "types": "./dist/proof/helper.d.ts",
      "default": "./dist/proof/helper.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "docs",
    "skills/skillunit",
    "README.md",
    "LICENSE"
  ],
  "nx": {
    "name": "skillunit",
    "namedInputs": {
      "shipped": [
        "{workspaceRoot}/README.md",
        "{workspaceRoot}/LICENSE",
        "{workspaceRoot}/docs/**/*",
        "{workspaceRoot}/skills/skillunit/**/*"
      ]
    },
    "targets": {
      "build": {
        "inputs": ["production", "^production", "shipped"]
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && node ../../tools/tsc.mjs -p tsconfig.build.json",
    "typecheck": "node ../../tools/tsc.mjs --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepack": "node scripts/copy-shared-files.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "8.1.3",
    "@typesafe-ai/sdk": "^0.6.0",
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.19.0",
    "typescript": "~5.6.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.1.1"
  }
}
