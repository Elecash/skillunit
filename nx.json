{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/vitest.config.ts"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "cache": true
    },
    "typecheck": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "cache": true
    },
    "test": {
      "inputs": [
        "default",
        "^production"
      ],
      "cache": true
    }
  },
  "analytics": true,
  "release": {
    "projects": [
      "skillunit"
    ],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "conventionalCommits": true,
      "versionActionsOptions": {
        "skipLockFileUpdate": true
      }
    },
    "conventionalCommits": {
      "useCommitScope": false
    },
    "changelog": {
      "workspaceChangelog": {
        "file": "{workspaceRoot}/CHANGELOG.md",
        "createRelease": "github"
      },
      "projectChangelogs": false,
      "git": {
        "commitMessage": "chore(release): publish {version}"
      }
    }
  }
}
