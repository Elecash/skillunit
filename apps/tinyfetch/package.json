{
  "name": "tinyfetch",
  "version": "0.0.0",
  "private": true,
  "description": "A small HTTP client for JSON APIs, built on fetch. The sample library SkillUnit tests its layers against.",
  "type": "module",
  "exports": "./src/index.ts",
  "nx": {
    "name": "tinyfetch",
    "targets": {
      "skill": {
        "dependsOn": ["skillunit:build"],
        "cache": false
      }
    }
  },
  "scripts": {
    "typecheck": "node ../../tools/tsc.mjs --noEmit",
    "test": "vitest run",
    "skill": "node ../../packages/skillunit/dist/cli.js check"
  }
}
